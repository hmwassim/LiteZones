#include <windows.h>
#include "resource.h"

IDI_APP ICON "icon.ico"

IDA_EDITOR ACCELERATORS
BEGIN
    "S",            IDM_FILE_SAVE,      VIRTKEY, CONTROL
    "N",            IDM_FILE_NEW,       VIRTKEY, CONTROL
    VK_RETURN,      IDM_FILE_APPLY,     VIRTKEY, CONTROL
    VK_RETURN,      IDM_FILE_APPLYALL,  VIRTKEY, CONTROL, SHIFT
    "Z",            IDM_EDIT_UNDO,      VIRTKEY, CONTROL
    "Y",            IDM_EDIT_REDO,      VIRTKEY, CONTROL
    VK_F2,          IDM_EDIT_RENAME,    VIRTKEY
    VK_DELETE,      IDM_EDIT_DELETE,    VIRTKEY
    "D",            IDM_EDIT_DUPLICATE, VIRTKEY, CONTROL
END

IDD_NEW_LAYOUT DIALOGEX 0, 0, 240, 130
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Layout"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Name:", -1, 12, 16, 40, 8
    EDITTEXT IDC_NEW_NAME, 56, 14, 172, 12, ES_AUTOHSCROLL
    CONTROL "Grid", IDC_NEW_GRID, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 56, 36, 60, 10
    CONTROL "Canvas", IDC_NEW_CANVAS, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 130, 36, 60, 10
    GROUPBOX "Grid options", -1, 56, 52, 172, 38
    LTEXT "Rows:", -1, 68, 68, 28, 8
    EDITTEXT IDC_NEW_ROWS, 100, 66, 30, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Columns:", -1, 140, 68, 36, 8
    EDITTEXT IDC_NEW_COLS, 180, 66, 30, 12, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON "OK", IDOK, 74, 100, 50, 14, WS_GROUP
    PUSHBUTTON "Cancel", IDCANCEL, 132, 100, 50, 14
END

IDD_RENAME_LAYOUT DIALOGEX 0, 0, 240, 70
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename Layout"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Name:", -1, 12, 16, 40, 8
    EDITTEXT IDC_RENAME_NAME, 56, 14, 172, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 74, 44, 50, 14, WS_GROUP
    PUSHBUTTON "Cancel", IDCANCEL, 132, 44, 50, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 340, 310
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LiteZones Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Behavior", -1, 8, 6, 324, 80
    AUTOCHECKBOX "Shift+drag to snap windows", IDC_CHK_SHIFT_DRAG, 16, 18, 200, 10
    AUTOCHECKBOX "Middle-click to span multiple zones", IDC_CHK_MOUSE_MIDDLE, 16, 30, 200, 10
    AUTOCHECKBOX "Move windows across monitors", IDC_CHK_MOVE_ACROSS, 16, 42, 200, 10
    AUTOCHECKBOX "Restore window size when unsnapping", IDC_CHK_RESTORE_SIZE, 16, 54, 200, 10
    AUTOCHECKBOX "Span zones across monitors", IDC_CHK_SPAN_MONITORS, 16, 66, 200, 10
    AUTOCHECKBOX "Make dragged window transparent", IDC_CHK_TRANSPARENT, 16, 78, 200, 10

    GROUPBOX "Appearance", -1, 8, 90, 324, 80
    AUTOCHECKBOX "Show zone numbers", IDC_CHK_ZONE_NUMBER, 16, 102, 200, 10
    LTEXT "Highlight opacity (0-100):", -1, 16, 116, 120, 8
    EDITTEXT IDC_EDIT_OPACITY, 140, 114, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Zone color (#RRGGBB):", -1, 16, 132, 100, 8
    EDITTEXT IDC_EDIT_ZONE_COLOR, 120, 130, 70, 12, ES_AUTOHSCROLL
    LTEXT "Border color:", -1, 16, 146, 100, 8
    EDITTEXT IDC_EDIT_BORDER_COLOR, 120, 144, 70, 12, ES_AUTOHSCROLL
    LTEXT "Highlight color:", -1, 200, 132, 70, 8
    EDITTEXT IDC_EDIT_HIGHLIGHT_COLOR, 274, 130, 50, 12, ES_AUTOHSCROLL
    LTEXT "Number color:", -1, 200, 146, 70, 8
    EDITTEXT IDC_EDIT_NUMBER_COLOR, 274, 144, 50, 12, ES_AUTOHSCROLL

    GROUPBOX "Excluded applications", -1, 8, 176, 324, 110
    LISTBOX IDC_LST_EXCLUDED_APPS, 16, 188, 240, 80, WS_BORDER | WS_VSCROLL | LBS_NOTIFY
    EDITTEXT IDC_EDIT_EXCLUDED_APP, 264, 188, 56, 12, ES_AUTOHSCROLL
    PUSHBUTTON "Add", IDC_BTN_ADD_APP, 264, 204, 56, 14
    PUSHBUTTON "Remove", IDC_BTN_REMOVE_APP, 264, 222, 56, 14

    DEFPUSHBUTTON "OK", IDOK, 128, 294, 50, 14, WS_GROUP
    PUSHBUTTON "Cancel", IDCANCEL, 184, 294, 50, 14
END
