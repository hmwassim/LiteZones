#include <windows.h>
#include "utils/resource.h"

IDI_APP ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LiteZones"
            VALUE "FileDescription", "LiteZones"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "LiteZones.exe"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "LiteZones.exe"
            VALUE "ProductName", "LiteZones"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDA_EDITOR ACCELERATORS
BEGIN
    "S",            IDM_FILE_SAVE,      VIRTKEY, CONTROL
    "N",            IDM_FILE_NEW,       VIRTKEY, CONTROL
    VK_RETURN,      IDM_FILE_APPLY,     VIRTKEY, CONTROL
    VK_RETURN,      IDM_FILE_APPLYALL,  VIRTKEY, CONTROL, SHIFT
    "Z",            IDM_EDIT_UNDO,      VIRTKEY, CONTROL
    "Y",            IDM_EDIT_REDO,      VIRTKEY, CONTROL
    VK_F2,          IDM_EDIT_RENAME,    VIRTKEY
    VK_DELETE,      IDM_EDIT_DELETE,    VIRTKEY
    "D",            IDM_EDIT_DUPLICATE, VIRTKEY, CONTROL
END

IDD_NEW_LAYOUT DIALOGEX 0, 0, 240, 130
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Layout"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Name:", -1, 12, 16, 40, 8
    EDITTEXT IDC_NEW_NAME, 56, 14, 172, 12, ES_AUTOHSCROLL
    CONTROL "Grid", IDC_NEW_GRID, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 56, 36, 60, 10
    CONTROL "Canvas", IDC_NEW_CANVAS, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 130, 36, 60, 10
    GROUPBOX "Grid options", -1, 56, 52, 172, 38
    LTEXT "Rows:", -1, 68, 68, 28, 8
    EDITTEXT IDC_NEW_ROWS, 100, 66, 30, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Columns:", -1, 140, 68, 36, 8
    EDITTEXT IDC_NEW_COLS, 180, 66, 30, 12, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON "OK", IDOK, 74, 100, 50, 14, WS_GROUP
    PUSHBUTTON "Cancel", IDCANCEL, 132, 100, 50, 14
END

IDD_RENAME_LAYOUT DIALOGEX 0, 0, 240, 70
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename Layout"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Name:", -1, 12, 16, 40, 8
    EDITTEXT IDC_RENAME_NAME, 56, 14, 172, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 74, 44, 50, 14, WS_GROUP
    PUSHBUTTON "Cancel", IDCANCEL, 132, 44, 50, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 340, 346
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LiteZones Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Behavior", -1, 8, 6, 324, 114
    AUTOCHECKBOX "Shift+drag to snap windows", IDC_CHK_SHIFT_DRAG, 16, 18, 200, 10
    AUTOCHECKBOX "Right-click to snap windows", IDC_CHK_MOUSE_SWITCH, 16, 30, 200, 10
    AUTOCHECKBOX "Middle-click to span multiple zones", IDC_CHK_MOUSE_MIDDLE, 16, 42, 200, 10
    AUTOCHECKBOX "Move windows across monitors", IDC_CHK_MOVE_ACROSS, 16, 54, 200, 10
    AUTOCHECKBOX "Restore window size when unsnapping", IDC_CHK_RESTORE_SIZE, 16, 66, 200, 10
    AUTOCHECKBOX "Span zones across monitors", IDC_CHK_SPAN_MONITORS, 16, 78, 200, 10
    AUTOCHECKBOX "Make dragged window transparent", IDC_CHK_TRANSPARENT, 16, 90, 200, 10
    AUTOCHECKBOX "Start with Windows", IDC_CHK_AUTOSTART, 16, 102, 200, 10

    GROUPBOX "Appearance", -1, 8, 124, 324, 92
    AUTOCHECKBOX "Show zone numbers", IDC_CHK_ZONE_NUMBER, 16, 136, 200, 10
    AUTOCHECKBOX "Show zone size (pixels)", IDC_CHK_ZONE_SIZE, 16, 148, 200, 10
    LTEXT "Highlight opacity (0-100):", -1, 16, 162, 120, 8
    EDITTEXT IDC_EDIT_OPACITY, 140, 160, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Zone color (#RRGGBB):", -1, 16, 178, 100, 8
    EDITTEXT IDC_EDIT_ZONE_COLOR, 120, 176, 70, 12, ES_AUTOHSCROLL
    LTEXT "Border color:", -1, 16, 192, 100, 8
    EDITTEXT IDC_EDIT_BORDER_COLOR, 120, 190, 70, 12, ES_AUTOHSCROLL
    LTEXT "Highlight color:", -1, 200, 178, 70, 8
    EDITTEXT IDC_EDIT_HIGHLIGHT_COLOR, 274, 176, 50, 12, ES_AUTOHSCROLL
    LTEXT "Number color:", -1, 200, 192, 70, 8
    EDITTEXT IDC_EDIT_NUMBER_COLOR, 274, 190, 50, 12, ES_AUTOHSCROLL

    GROUPBOX "Excluded applications", -1, 8, 222, 324, 100
    LISTBOX IDC_LST_EXCLUDED_APPS, 16, 234, 240, 68, WS_BORDER | WS_VSCROLL | LBS_NOTIFY
    EDITTEXT IDC_EDIT_EXCLUDED_APP, 264, 234, 56, 12, ES_AUTOHSCROLL
    PUSHBUTTON "Add", IDC_BTN_ADD_APP, 264, 250, 56, 14
    PUSHBUTTON "Remove", IDC_BTN_REMOVE_APP, 264, 268, 56, 14

    PUSHBUTTON "Apply", IDC_APPLY, 72, 330, 50, 14
    DEFPUSHBUTTON "OK", IDOK, 128, 330, 50, 14, WS_GROUP
    PUSHBUTTON "Cancel", IDCANCEL, 184, 330, 50, 14
END
